{
  "name": "api2devin",
  "displayName": "API2Devin",
  "description": "API2Devin - Devin Desktop BYOK 桥接，基于 ycx932436/devin-byok-bridge Fork",
  "version": "2.6.2",
  "publisher": "Diandian-ops",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.mjs\"",
    "package": "npx @vscode/vsce package --no-dependencies",
    "build": "npm run package",
    "prepackage": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Diandian-ops/api2devin.git"
  },
  "homepage": "https://github.com/Diandian-ops/api2devin",
  "bugs": {
    "url": "https://github.com/Diandian-ops/api2devin/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "api2devin",
          "title": "API2Devin",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "api2devin": [
        {
          "type": "webview",
          "id": "api2devin.sidebar",
          "name": "控制面板",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "api2devin.startProxy",
        "title": "API2Devin: 启动代理"
      },
      {
        "command": "api2devin.stopProxy",
        "title": "API2Devin: 停止代理"
      },
      {
        "command": "api2devin.applyPatch",
        "title": "API2Devin: 安装补丁"
      },
      {
        "command": "api2devin.revertPatch",
        "title": "API2Devin: 还原补丁"
      },
      {
        "command": "api2devin.reloadWorkbench",
        "title": "API2Devin: 重载窗口（补丁生效）"
      }
    ]
  }
}
